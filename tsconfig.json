{
	"compilerOptions": {
		"target": "ES2023",
		"module": "commonjs",

		"sourceMap": false,
		"strictNullChecks": false,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,

		"rootDir": ".",
		"outDir": "dist"
	},

	"include": ["src/**/*.ts", "index.ts"],
	"exclude": ["node_modules", "cp.ts"]
}
