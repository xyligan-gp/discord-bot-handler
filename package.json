{
	"name": "discord-bot-handler",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"start": "node .",
		"dev": "chcp 65001 && nodemon --exec tsx index.ts",
		"build": "tsc -p tsconfig.json",
		"build:prod": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.json && tsx cp.ts",
		"updater": "node ./updater.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyligan-gp/discord-bot-handler.git"
	},
	"author": "xyligan <contact.csdevs@gmail.com>",
	"license": "Apache-2.0",
	"dependencies": {
		"discord.js": "^14.26.4",
		"dotenv": "^17.4.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"nodemon": "^3.1.14",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"bugs": {
		"url": "https://github.com/xyligan-gp/discord-bot-handler/issues"
	},
	"homepage": "https://github.com/xyligan-gp/discord-bot-handler#readme",
	"types": "./types.d.ts"
}
